# docseed のバックアップの設定（sudo cp scripts/ops/backup.env.example /etc/docseed/backup.env して編集）。
# このファイルとパスワードのファイルは root だけが読めるようにする（chmod 600）。

# restic の保存先。外付け USB ドライブの例（ext4 でフォーマットし、/mnt/backup にマウントしておく）
RESTIC_REPOSITORY=/mnt/backup/docseed-restic
# 別のマシンへ SFTP で送る例:      RESTIC_REPOSITORY=sftp:backup@nas.local:/volume1/docseed-restic
# restic の REST サーバーの例:      RESTIC_REPOSITORY=rest:http://nas.local:8000/docseed

# リポジトリの暗号化パスワード（1 行だけのファイル）。失うと復元できないので、別の場所（紙など）にも控える
RESTIC_PASSWORD_FILE=/etc/docseed/restic-password

# 残す世代（日次・週次・月次）
DOCSEED_KEEP_DAILY=7
DOCSEED_KEEP_WEEKLY=4
DOCSEED_KEEP_MONTHLY=6

# 週 1 回の検査で実際に読み出して確かめるデータの割合
DOCSEED_CHECK_SUBSET=5%
