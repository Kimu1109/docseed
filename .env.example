# docseed の設定（docs/design/deployment.md 3 章）。cp .env.example .env して値を入れる。
# .env は Git に入れないこと。

# 名前で開く場合のホスト名（Caddy が使う）。例: docseed.local / docseed.tailxxxx.ts.net
DOCSEED_HOST=docseed.local
# IP アドレスで直接開く場合の Pi の LAN の IP アドレス（例 192.168.1.20）。名前だけで開くなら空のままでよい
DOCSEED_LAN_IP=

# Caddy が使うホスト側のポート。80 / 443 が他のサービス（nginx・Apache・Pi-hole など）で
# 使われている場合は空いている番号に変える（例: 8080 / 8443）。
# HTTPS のポートを変えた場合は https://<DOCSEED_HOST または DOCSEED_LAN_IP>:8443/ のようにポート付きで開く
# （HTTP のポートで開いても、HTTPS の同じポートへ転送される）。
DOCSEED_HTTPS_PORT=443
DOCSEED_HTTP_PORT=80

# 証明書の方式（DOCSEED_HOST の名前で開いたとき）
#   internal: Caddy の内部 CA（既定）。初回はブラウザに警告が出る
#   file    : 手元の証明書ファイルを使う（certbot で取った Let's Encrypt の証明書など）。
#             DOCSEED_HOST は証明書に含まれる名前にすること（違う名前で開くとブラウザが拒否する）
#   tailscale: Tailscale の証明書（推奨）。DOCSEED_HOST=<機械名>.<tailnet>.ts.net にし、
#             Tailscale の管理画面で MagicDNS と HTTPS を有効にする（README）
#   acme_dns: 自分のドメインの Let's Encrypt の証明書を DNS-01 で取る。DNS のプラグイン入りの Caddy が要る（README）
DOCSEED_TLS_MODE=internal
# file のとき: 証明書のあるホスト側のディレクトリ（コンテナの /certs に読み取り専用で入る）と、その中の相対パス。
# certbot の場合は /etc/letsencrypt ごと指定する（live/ の中は archive/ へのシンボリックリンクのため）
#DOCSEED_TLS_CERT_DIR=/etc/letsencrypt
#DOCSEED_TLS_CERT=live/example.com/fullchain.pem
#DOCSEED_TLS_KEY=live/example.com/privkey.pem
# tailscale のとき: tailscaled.sock のあるホスト側のディレクトリ（通常は変えない）
#DOCSEED_TAILSCALE_SOCKET_DIR=/var/run/tailscale
# acme_dns のとき: docker compose --profile acme build caddy-acme でビルドし、その Caddy を使う
#DOCSEED_CADDY_IMAGE=docseed-caddy:latest
# DNS 事業者の API トークン（Cloudflare なら Zone:DNS:Edit の権限だけを付ける。秘密）
DOCSEED_ACME_DNS_TOKEN=
# Let's Encrypt に登録する連絡先（空でもよい）
DOCSEED_ACME_EMAIL=
# true にすると Let's Encrypt の試験用の環境を使う（初回の確認用。ブラウザは信頼しない証明書になる）
DOCSEED_ACME_STAGING=false

# ---- ログイン（パスキー・外部アカウント）----
# パスキーを登録する名前（RP ID）。空なら DOCSEED_HOST の最初の名前。IP アドレスは使えない。
# 注意: 後から変えると、登録済みのパスキーはすべて使えなくなる
#DOCSEED_RP_ID=
# 外部アカウント（OIDC）でのログイン。使う提供者の名前をカンマ区切りで書き、名前ごとに 4 つの値を設定する。
# Google のリダイレクト URI: https://<DOCSEED_HOST>[:<DOCSEED_HTTPS_PORT>]/auth/oidc/google/callback（README を参照）
DOCSEED_OIDC_PROVIDERS=
#DOCSEED_OIDC_GOOGLE_ISSUER=https://accounts.google.com
#DOCSEED_OIDC_GOOGLE_CLIENT_ID=
#DOCSEED_OIDC_GOOGLE_CLIENT_SECRET=
#DOCSEED_OIDC_GOOGLE_LABEL=Google

# ホスト側のデータディレクトリ（SSD 上）
DOCSEED_DATA_DIR=/srv/docseed

# Cookie 署名用の秘密鍵（必須）。生成例: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
DOCSEED_SECRET_KEY=

# 1 ファイルのアップロード上限（MB）
DOCSEED_MAX_UPLOAD_MB=1024

# ゴミ箱の保持日数
DOCSEED_TRASH_RETENTION_DAYS=30

# HTTPS で使う場合は true（既定）。HTTP で直接アクセスして試すときだけ false にする
DOCSEED_COOKIE_SECURE=true

# 画面に表示する時刻のタイムゾーン
DOCSEED_TIMEZONE=Asia/Tokyo

DOCSEED_LOG_LEVEL=INFO

# ---- 文字の読み取り（worker）。通常は変更不要（Phase 0 の計測で決めた値） ----
# OCR モデル: ppocrv6_small（既定）/ ppocrv6_medium（精度重視。約 4 倍遅い）
DOCSEED_OCR_ENGINE=ppocrv6_small
# PDF を画像にするときの解像度
DOCSEED_OCR_DPI=200
# 文字領域の検出に使う画像の長辺（px）
DOCSEED_OCR_DET_SIDE=1600
# 推論のスレッド数（4 コアのうち 1 つは Web 画面用に残す）
DOCSEED_OCR_THREADS=3
DOCSEED_EMBED_THREADS=3
# CPU がこの温度（℃）を超えたら処理を一時停止する
DOCSEED_THERMAL_PAUSE_C=80

# ---- 検索 ----
# 意味検索だけで見つかった部分を結果に含める類似度の下限（0〜1）。
# 無関係な結果が多いときは上げ、見つからないときは下げる（scripts/eval_search.py で比べられる）
DOCSEED_SEARCH_SEM_MIN=0.80

# ---- 受け取り箱（inbox）----
# true にすると /srv/docseed/inbox/<ユーザー名>/ に置いたファイルを各ユーザーの「Inbox」フォルダへ取り込む
DOCSEED_INBOX_ENABLED=false
# 取り込んだ元ファイルを消さずに inbox/<ユーザー名>/.imported/ へ移す
DOCSEED_INBOX_KEEP=false

# ---- URL の取り込み（Web クリップ）----
# true にすると、フォルダの画面の「URL を追加」とブックマークレットで Web ページを保存できる。
# 取得は fetcher が行う（外部へ通信する）。使うときは COMPOSE_PROFILES=webclip も設定して docker compose up -d
DOCSEED_WEBCLIP_ENABLED=false
#COMPOSE_PROFILES=webclip
# HTML の大きさの上限（MB）。PDF・画像の URL は DOCSEED_MAX_UPLOAD_MB まで
DOCSEED_WEBCLIP_MAX_MB=5
# 取得に使うプロキシ（例 http://proxy.lan:3128）。設定すると名前の解決をプロキシに任せるので、
# プロキシ側で LAN（プライベートな IP）への通信を止めること
DOCSEED_WEBCLIP_PROXY=

# ---- 整理の補助（フォルダ・タグの候補、要約）----
# 似ている文書から、置くフォルダと付けるタグの候補を出す（追加の負荷はほぼない）
DOCSEED_SUGGEST_ENABLED=true
# 要約と新しいタグの提案に小型の LLM を使う。RAM 16GB を推奨（8GB なら DOCSEED_LLM_MODEL を小さいものに）。
# 使うときは COMPOSE_PROFILES に llm を足し（例 COMPOSE_PROFILES=webclip,llm）、モデルを取得する:
#   docker compose exec api docseed fetch-models --llm sarashina2.2-1b
DOCSEED_LLM_ENABLED=false
# models/llm/ の GGUF のファイル名（docseed fetch-models --llm の最後に表示される）
DOCSEED_LLM_MODEL=sarashina2.2-1b-instruct-v0.1-Q4_K_M.gguf
DOCSEED_LLM_THREADS=3
# 1 件の上限（秒）と、渡す本文の上限（文字）
DOCSEED_LLM_TIMEOUT_S=180
DOCSEED_LLM_MAX_INPUT_CHARS=3000
