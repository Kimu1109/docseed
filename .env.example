# docseed の設定（一覧と説明は docs/admin/configuration.md）。cp .env.example .env して値を入れる。
# .env は Git に入れないこと。

# 名前で開く場合のホスト名（Caddy が使う）。例: docseed.local / docseed.tailxxxx.ts.net
DOCSEED_HOST=docseed.local
# IP アドレスで直接開く場合の Pi の LAN の IP アドレス（例 192.168.1.20）。名前だけで開くなら空のままでよい
DOCSEED_LAN_IP=

# Caddy が使うホスト側のポート。80 / 443 が他のサービス（nginx・Apache・Pi-hole など）で
# 使われている場合は空いている番号に変える（例: 8080 / 8443）。
# HTTPS のポートを変えた場合は https://<DOCSEED_HOST または DOCSEED_LAN_IP>:8443/ のようにポート付きで開く
# （HTTP のポートで開いても、HTTPS の同じポートへ転送される）。
DOCSEED_HTTPS_PORT=443
DOCSEED_HTTP_PORT=80

# 証明書の方式（DOCSEED_HOST の名前で開いたとき）
#   internal: Caddy の内部 CA（既定）。初回はブラウザに警告が出る
#   file    : 手元の証明書ファイルを使う（certbot で取った Let's Encrypt の証明書など）。
#             DOCSEED_HOST は証明書に含まれる名前にすること（違う名前で開くとブラウザが拒否する）
#   tailscale: Tailscale の証明書（推奨）。DOCSEED_HOST=<機械名>.<tailnet>.ts.net にし、
#             Tailscale の管理画面で MagicDNS と HTTPS を有効にする（docs/admin/https.md）
#   acme_dns: 自分のドメインの Let's Encrypt の証明書を DNS-01 で取る。DNS のプラグイン入りの Caddy が要る（docs/admin/https.md）
DOCSEED_TLS_MODE=internal
# file のとき: 証明書のあるホスト側のディレクトリ（コンテナの /certs に読み取り専用で入る）と、その中の相対パス。
# certbot の場合は /etc/letsencrypt ごと指定する（live/ の中は archive/ へのシンボリックリンクのため）
#DOCSEED_TLS_CERT_DIR=/etc/letsencrypt
#DOCSEED_TLS_CERT=live/example.com/fullchain.pem
#DOCSEED_TLS_KEY=live/example.com/privkey.pem
# tailscale のとき: tailscaled.sock のあるホスト側のディレクトリ（通常は変えない）
#DOCSEED_TAILSCALE_SOCKET_DIR=/var/run/tailscale
# acme_dns のとき: docker compose --profile acme build caddy-acme でビルドし、その Caddy を使う
#DOCSEED_CADDY_IMAGE=docseed-caddy:latest
# DNS 事業者の API トークン（Cloudflare なら Zone:DNS:Edit の権限だけを付ける。秘密）
DOCSEED_ACME_DNS_TOKEN=
# Let's Encrypt に登録する連絡先（空でもよい）
DOCSEED_ACME_EMAIL=
# true にすると Let's Encrypt の試験用の環境を使う（初回の確認用。ブラウザは信頼しない証明書になる）
DOCSEED_ACME_STAGING=false

# ---- インターネットに公開する場合（docs/admin/exposure.md）----
# 「内側」とみなす接続元。ここ以外からは管理画面（/admin）・管理用 API（/api/v1/admin）・API の説明ページ・/healthz が
# 404 になり、IP アドレス（DOCSEED_LAN_IP）で開くサイトは接続を切る。空白区切りで CIDR を並べる。
# 既定（空のとき）: private_ranges 100.64.0.0/10（LAN のプライベートなアドレスと Tailscale）。
# 例: Tailscale からだけ管理する → 100.64.0.0/10 fd7a:115c:a1e0::/48
#DOCSEED_TRUSTED_NETS=

# ログイン以外の流量の制限（共有リンク・検索・ログインの開始など。接続元の IP ごと）。通常は true のまま
DOCSEED_RATE_LIMIT=true

# ---- ポートを開けずに公開する（Cloudflare Tunnel。docs/admin/exposure.md）----
# Cloudflare の管理画面で作ったトンネルのトークン（秘密）。使うときは COMPOSE_PROFILES に tunnel を足す
DOCSEED_TUNNEL_TOKEN=
# cloudflared だけが入るネットワーク。ほかのネットワークと重なるときだけ変える
#DOCSEED_TUNNEL_SUBNET=10.213.47.0/28

# ---- URL の起点（任意）----
# https://example.com/docseed/ のように、パスの下で動かすときの接頭辞（docs/admin/exposure.md）。空ならドメインの直下
#DOCSEED_BASE_PATH=/docseed
# ブラウザから見たオリジン。外側に別のリバースプロキシを置き、ポート番号などが DOCSEED_HOST と
# DOCSEED_HTTPS_PORT から作るものと違うときだけ書く（例 https://example.com）。パスまで書くと接頭辞としても使う
#DOCSEED_PUBLIC_URL=

# ---- ログイン（パスキー・外部アカウント）----
# パスキーを登録する名前（RP ID）。空なら DOCSEED_HOST の最初の名前。IP アドレスは使えない。
# 注意: 後から変えると、登録済みのパスキーはすべて使えなくなる
#DOCSEED_RP_ID=
# 外部アカウント（OIDC）でのログイン。使う提供者の名前をカンマ区切りで書き、名前ごとに 4 つの値を設定する。
# Google のリダイレクト URI: https://<DOCSEED_HOST>[:<DOCSEED_HTTPS_PORT>]/auth/oidc/google/callback（docs/admin/users.md）
DOCSEED_OIDC_PROVIDERS=
#DOCSEED_OIDC_GOOGLE_ISSUER=https://accounts.google.com
#DOCSEED_OIDC_GOOGLE_CLIENT_ID=
#DOCSEED_OIDC_GOOGLE_CLIENT_SECRET=
#DOCSEED_OIDC_GOOGLE_LABEL=Google

# ホスト側のデータディレクトリ（SSD 上）
DOCSEED_DATA_DIR=/srv/docseed

# Cookie 署名用の秘密鍵（必須）。生成例: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
DOCSEED_SECRET_KEY=

# 1 ファイルのアップロード上限（MB）
DOCSEED_MAX_UPLOAD_MB=1024

# ゴミ箱の保持日数の既定（利用者は設定画面で 7・14・30・60・90・180・365 日から選べる）
DOCSEED_TRASH_RETENTION_DAYS=30

# 1 つのファイルに残す過去の版の数（同じ名前で上書きしたとき・新しい版をアップロードしたとき）。0 なら残さない
DOCSEED_VERSIONS_KEEP=10

# HTTPS で使う場合は true（既定）。HTTP で直接アクセスして試すときだけ false にする
DOCSEED_COOKIE_SECURE=true

# 画面に表示する時刻のタイムゾーン
DOCSEED_TIMEZONE=Asia/Tokyo

DOCSEED_LOG_LEVEL=INFO

# ---- 共有リンクの「受け取り用」（ログインなしでファイルを送ってもらう）の上限 ----
# 受け取り用のリンクの期限は 30 日まで（無期限は不可）。次の 3 つのどれかに達すると受け取りを止める
# 1 リンクで受け取る合計（GB）
DOCSEED_SHARE_UPLOAD_LINK_GB=10
# すべての受け取り用リンクで、直近 24 時間に受け取る合計（GB）
DOCSEED_SHARE_UPLOAD_DAILY_GB=20
# 保存先の空きがこの割合（%）を下回ったら受け取らない（ログインしたユーザーのアップロードは 5% まで使える）
DOCSEED_SHARE_UPLOAD_MIN_FREE_PCT=10

# ---- 文字の読み取り（worker）。通常は変更不要（Phase 0 の計測で決めた値） ----
# OCR モデル: ppocrv6_small（既定）/ ppocrv6_medium（精度重視。約 4 倍遅い）
DOCSEED_OCR_ENGINE=ppocrv6_small
# PDF を画像にするときの解像度
DOCSEED_OCR_DPI=200
# 文字領域の検出に使う画像の長辺（px）
DOCSEED_OCR_DET_SIDE=1600
# テキスト層のある PDF でも、ページに貼られた図・写真・スクリーンショットの中の文字を読み取る
# （ページ全体を覆う画像＝スキャンしたページは除く。false にすると今まで通りテキスト層だけを使う）
DOCSEED_OCR_PDF_IMAGES=true
# 推論のスレッド数（4 コアのうち 1 つは Web 画面用に残す）
DOCSEED_OCR_THREADS=3
DOCSEED_EMBED_THREADS=3
# CPU がこの温度（℃）を超えたら処理を一時停止する
DOCSEED_THERMAL_PAUSE_C=80
# この温度（℃）を超えたら「温度が高め」と警告する（一時停止の前の注意）
DOCSEED_THERMAL_WARN_C=75
# 使えるメモリがこの割合（%）を下回ったら警告する
DOCSEED_MEMORY_WARN_PCT=10

# ---- 通知 ----
# 宛先を 1 つ以上書くと、監視の警告（出た・重くなった・解消した）、共有リンクでの受け取り、受け取り箱の取り込みを知らせる。
# Webhook の URL（カンマか空白で区切る）。Discord・Slack の Webhook と ntfy.sh はそのまま書けば形式を見分ける。
# 自前の ntfy などは形式を前に付ける: ntfy+https://ntfy.example.com/トピック / slack+https://... / discord+https://...
# それ以外の URL には JSON（{"title", "message", "level", "text"}）を送る。URL は秘密として扱う（漏れると誰でも送れる）
DOCSEED_NOTIFY_URLS=
# メールで知らせる宛先（カンマ区切り）。DOCSEED_SMTP_HOST も必要
DOCSEED_NOTIFY_EMAIL=
DOCSEED_SMTP_HOST=
DOCSEED_SMTP_PORT=587
# starttls（587 番）/ ssl（465 番）/ none
DOCSEED_SMTP_SECURITY=starttls
DOCSEED_SMTP_USER=
DOCSEED_SMTP_PASSWORD=
# 差出人（省略時は DOCSEED_SMTP_USER）
DOCSEED_SMTP_FROM=
# 知らせること（alert: 監視の警告、share_upload: 共有リンクでの受け取り、inbox: 受け取り箱の取り込み）
DOCSEED_NOTIFY_EVENTS=alert,share_upload,inbox

# ---- 検索 ----
# 意味検索だけで見つかった部分を結果に含める類似度の下限（0〜1）。
# 無関係な結果が多いときは上げ、見つからないときは下げる（scripts/eval_search.py で比べられる）
DOCSEED_SEARCH_SEM_MIN=0.80

# ---- 受け取り箱（inbox）----
# true にすると /srv/docseed/inbox/<ユーザー名>/ に置いたファイルを各ユーザーの「Inbox」フォルダへ取り込む
DOCSEED_INBOX_ENABLED=false
# 取り込んだ元ファイルを消さずに inbox/<ユーザー名>/.imported/ へ移す
DOCSEED_INBOX_KEEP=false

# ---- URL の取り込み（Web クリップ）----
# true にすると、フォルダの画面の「URL を追加」とブックマークレットで Web ページを保存できる。
# 取得は fetcher が行う（外部へ通信する）。使うときは COMPOSE_PROFILES=webclip も設定して docker compose up -d
DOCSEED_WEBCLIP_ENABLED=false
#COMPOSE_PROFILES=webclip
# 複数使うときはカンマ区切り（例 COMPOSE_PROFILES=webclip,llm,tunnel）
# HTML の大きさの上限（MB）。PDF・画像の URL は DOCSEED_MAX_UPLOAD_MB まで
DOCSEED_WEBCLIP_MAX_MB=5
# 取得に使うプロキシ（例 http://proxy.lan:3128）。設定すると名前の解決をプロキシに任せるので、
# プロキシ側で LAN（プライベートな IP）への通信を止めること
DOCSEED_WEBCLIP_PROXY=
# JavaScript で描くページ（本文が短いページ）を、ヘッドレス Chromium で描いてから保存する（任意・別コンテナ）。
# 使うときは COMPOSE_PROFILES に webclip-render も足し、下の URL を設定する（メモリを 1GB ほど使う）。
#   docker compose build webclip-browser
DOCSEED_WEBCLIP_RENDER_URL=
#COMPOSE_PROFILES=webclip,webclip-render
# 描画が Chromium のサンドボックスで止まるときだけ 1（コンテナの中の制限を緩めるので、必要なときだけ）
DOCSEED_RENDER_NO_SANDBOX=0

# ---- 整理の補助（フォルダ・タグの候補、要約）----
# 似ている文書から、置くフォルダと付けるタグの候補を出す（追加の負荷はほぼない）
DOCSEED_SUGGEST_ENABLED=true
# 要約と新しいタグの提案、検索画面の「質問に答える」に小型の LLM を使う。RAM 16GB を推奨（8GB なら DOCSEED_LLM_MODEL を小さいものに）。
# 使うときは COMPOSE_PROFILES に llm を足し（例 COMPOSE_PROFILES=webclip,llm）、モデルを取得する:
#   docker compose exec api docseed fetch-models --llm lfm2.5-1.2b-jp
DOCSEED_LLM_ENABLED=false
# models/llm/ の GGUF のファイル名（docseed fetch-models --llm の最後に表示される）
DOCSEED_LLM_MODEL=LFM2.5-1.2B-JP-Q4_K_M.gguf
DOCSEED_LLM_THREADS=3
# 1 件の上限（秒）と、渡す本文の上限（文字。質問に答えるときは、資料にする文書の抜粋の合計の上限）
DOCSEED_LLM_TIMEOUT_S=180
DOCSEED_LLM_MAX_INPUT_CHARS=3000
# llama-server の同時の枠と文脈の長さ（1 つの枠は DOCSEED_LLM_CTX / DOCSEED_LLM_PARALLEL）。
# 2 にすると、要約の途中でも検索画面の「質問に答える」がすぐ始まる。メモリが足りなければ 1 と 4096 に戻す
DOCSEED_LLM_PARALLEL=2
DOCSEED_LLM_CTX=8192

# ---- 音声・動画の文字起こし（任意。バッチ処理・既定はオフ）----
# 有効にすると、音声・動画を 10 分ごとに区切って文字起こしし、検索できるようにする（Pi 5 の CPU では
# 1 時間の動画に数時間かかることがある。夜間などにまとめて処理される前提）。
# 使うときは次の 3 つを行う:
#   1. .env で DOCSEED_IMAGE_TARGET=asr にして、イメージを作り直す（ffmpeg と whisper-cli を入れる）
#   2. モデルを取得する: docker compose exec api docseed fetch-models --asr small
#   3. DOCSEED_ASR_ENABLED=true にして worker を再起動する（既に保存した音声・動画は、管理画面の「形式が未対応だったファイルを再処理」で読む）
DOCSEED_IMAGE_TARGET=base
DOCSEED_ASR_ENABLED=false
# models/asr/ の ggml ファイル名（fetch-models --asr の最後に表示される）。base は軽いが精度は下がる
DOCSEED_ASR_MODEL=ggml-small.bin
DOCSEED_ASR_LANGUAGE=ja
DOCSEED_ASR_THREADS=3
# 10 分の区切り 1 つの上限（秒）
DOCSEED_ASR_TIMEOUT_S=1800

# 映像（mp4・mov など）の保存時に、軽いプレビュー用の動画（H.264・長辺 854px 程度）を作る。
# 既定は作る（ffmpeg を使う。Pi 5 では 1 時間の動画に数時間かかることがある）。false で作らず、原本をそのまま再生する
DOCSEED_VIDEO_PROXY=true
