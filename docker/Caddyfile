# docs/design/deployment.md 2.2、docs/design/extensions.md 2 章
#
# 80 / 443 を Apache などが使っている Pi でも動くよう、Caddy はコンテナの中でも
# .env の DOCSEED_HTTP_PORT / DOCSEED_HTTPS_PORT と同じ番号で待ち受ける（compose.yaml で同じ番号を公開する）。
# こうしないと HTTP → HTTPS の転送先や Caddy が組み立てる URL が 443 になり、別のサービスに飛ばされる。
#
#   - DOCSEED_HOST   : 名前で開く場合のホスト名（例 docseed.local）。カンマ区切りで複数可
#   - DOCSEED_LAN_IP : IP アドレスで直接開く場合のアドレス（例 192.168.1.20）。
#                      IP で開くとブラウザがホスト名（SNI）を送らないため、default_sni にも使う
#
# 証明書（DOCSEED_HOST の名前で開いたとき）: .env の DOCSEED_TLS_MODE で選ぶ
#   - internal（既定）: Caddy の内部 CA。初回はブラウザに警告が出る（端末に CA を入れれば消える）
#   - file          : 手元の証明書ファイル（certbot で取った Let's Encrypt の証明書など）。
#                      DOCSEED_TLS_CERT_DIR（ホスト側）をコンテナの /certs に読み取り専用でマウントし、
#                      DOCSEED_TLS_CERT / DOCSEED_TLS_KEY はその中の相対パスで指定する
#   - tailscale     : Tailscale の証明書（tailscaled が Let's Encrypt から取る）。DOCSEED_HOST は <機械名>.<tailnet>.ts.net。
#                      ホストの /var/run/tailscale（tailscaled.sock）を読み取り専用でマウントする
#   - acme_dns      : 自分のドメインの Let's Encrypt の証明書を DNS-01 で取る（LAN の中だけで使える）。
#                      DNS のプラグイン入りの Caddy（docker/caddy/Dockerfile）が要る。既定は Cloudflare で、
#                      トークンは DOCSEED_ACME_DNS_TOKEN。DOCSEED_ACME_STAGING=true で Let's Encrypt の試験用の環境を使う
# IP アドレスで開いたときは、どの方式でも内部 CA の証明書を使う（公的な証明書は LAN の IP には出ないため）。
#
# 環境変数（{$...}）は Caddyfile の解析の前に置き換わるので、import するスニペットの名前にも使える。
{
	http_port {$DOCSEED_HTTP_PORT:80}
	https_port {$DOCSEED_HTTPS_PORT:443}
	default_sni {$DOCSEED_LAN_IP:localhost}
	auto_https disable_redirects
}

(tls_internal) {
	tls internal
}

(tls_file) {
	tls /certs/{$DOCSEED_TLS_CERT} /certs/{$DOCSEED_TLS_KEY}
}

(tls_tailscale) {
	tls {
		get_certificate tailscale
	}
}

# DOCSEED_ACME_EMAIL が空なら「tls {」になり、連絡先なしで登録する
(tls_acme_dns) {
	tls {$DOCSEED_ACME_EMAIL} {
		dns cloudflare {env.DOCSEED_ACME_DNS_TOKEN}
		# LAN の DNS が自分のドメインを Pi の IP に向けていても、TXT レコードの確認は公開の DNS で行う
		resolvers 1.1.1.1 1.0.0.1
		import acme_ca_{$DOCSEED_ACME_STAGING:false}
	}
}

(acme_ca_false) {
	ca https://acme-v02.api.letsencrypt.org/directory
}

(acme_ca_true) {
	ca https://acme-staging-v02.api.letsencrypt.org/directory
}

(app) {
	encode zstd gzip
	request_body {
		max_size 1GB
	}
	reverse_proxy api:8000 {
		flush_interval -1
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}

{$DOCSEED_HOST} {
	import tls_{$DOCSEED_TLS_MODE:internal}
	import app
}

{$DOCSEED_LAN_IP:localhost} {
	tls internal
	import app
}

# HTTP で来たら、同じホストの HTTPS のポートへ転送する（ポート番号を保つ）
http:// {
	redir https://{host}:{$DOCSEED_HTTPS_PORT:443}{uri} permanent
}
